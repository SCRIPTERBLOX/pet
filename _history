\"math_number\"><field name=\"NUM\">3</field></block></value></block></statement></block><block type=\"input_on_sound\" x=\"2155\" y=\"0\"><field name=\"sound\">DetectedSound.Loud</field><statement name=\"HANDLER\"><block type=\"control_raise_event\"><value name=\"src\"><shadow type=\"control_event_source_id\"><field name=\"id\">EventBusSource.MICROBIT_ID_BUTTON_A</field></shadow><block type=\"math_number\"><field name=\"NUM\">5</field></block></value><value name=\"value\"><shadow type=\"control_event_value_id\"><field name=\"id\">EventBusValue.MICROBIT_EVT_ANY</field></shadow><block type=\"math_number\"><field name=\"NUM\">5</field></block></value></block></statement></block></xml>","main.ts":"input.onButtonPressed(Button.A, function () {\n    control.raiseEvent(\n    0,\n    0\n    )\n})\ninput.onSound(DetectedSound.Loud, function () {\n    control.raiseEvent(\n    5,\n    5\n    )\n})\ninput.onButtonPressed(Button.B, function () {\n    control.raiseEvent(\n    1,\n    1\n    )\n})\ninput.onGesture(Gesture.Shake, function () {\n    control.raiseEvent(\n    3,\n    3\n    )\n})\nlet print = function (text: string) {\n    serial.writeLine(`[OUTPUT] (${input.runningTime()}) text`);\n}\nlet error = function (text: string) {\n    serial.writeLine(`[ERROR] (${input.runningTime()}) text`);\n}\nconst enum dataType {\n    fullfilmentTime,\n    moodGraph\n}\nconst enum faces {\n    happy,\n    neutral,\n    sad,\n    dead\n}\nclass Want {\n    index: number;\n    sound: SoundExpression;\n\n    constructor(i: number, s: SoundExpression) {\n        this.index = i;\n        this.sound = s;\n    }\n}\nconst wants = [\n    new Want(0, soundExpression.spring),\n    new Want(1, soundExpression.giggle),\n    new Want(2, soundExpression.yawn),\n    new Want(3, soundExpression.hello)\n];\nlet showFace = function (face: faces) {\n    switch (face) {\n        case faces.happy:\n            basic.showLeds(`\n                # # . # #\n                . . . . .\n                # # . # #\n                # # . # #\n                # # . # #`);\n            break;\n        case faces.neutral:\n            basic.showLeds(`\n                # # . # #\n                . . . . .\n                # # . # #\n                # # . # #\n                . . . . .`);\n            break;\n        case faces.sad:\n            basic.showLeds(`\n                . # . # .\n                # . . . #\n                # # . # #\n                # # . # #\n                . . . . .`);\n            break;\n        case faces.dead:\n            basic.showLeds(`\n                . # . # .\n                # . . . #\n                . . . . .\n                # # . # #\n                . . . . .`);\n            break;\n    }\n}\nclass Organism {\n    wantHistory: Want[];\n    mood: number;\n\n    constructor() {\n        this.wantHistory = [];\n        this.mood = 50;\n    }\n\n    showMood = function (mood: number) {\n        if (mood > 0 && mood < 25) showFace(faces.sad);\n        else if (mood >= 25 && mood < 75) showFace(faces.neutral);\n        else if (mood >= 75) showFace(faces.happy);\n        else showFace(faces.dead);\n    }\n\n    request = function () {\n        let want = wants[randint(0, wants.length - 1)];\n        input.calibrateCompass();\n\n        music.play(want.sound, music.PlaybackMode.UntilDone);\n        basic.showNumber(want.index); // Remove when verified that sound works\n        let start = input.runningTime();\n\n        control.waitForEvent(want.index, want.index);\n        let end = input.runningTime();\n        \n        let diff = end - start;\n\n        organism.wantHistory.push(want);\n        // TODO: Setup with data logging\n        print(`${organism.wantHistory[organism.wantHistory.length - 1].index}`);\n    }\n\n    sendData = function (dType: dataType, data: any) {\n        switch (dType) {\n            case dataType.fullfilmentTime:\n                // Fulllfilment time, record timestamp + time\n                let packet = `ft:${data[0]},${data[1]},${data[2]}`;\n        }\n    }\n}\nlet organism = new Organism();\nbasic.forever(function () {\n    while (true) {\n        organism.request();\n    }\n})\ncontrol.inBackground(function () {\n\t\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"pet\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[{"id":"64530-54045-83157-07142","timestamp":1794219769944},{"id":"79143-18061-01365-70157","timestamp":1794236243873}],"lastSaveTime":1794236839152}