<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="/.=ea?6E,`)T;6i7atDv">wants</variable></variables><block type="function_definition" x="10" y="10"><mutation name="changeMood" functionid="Dy[IziS9C;q$kYlyqxAQ"><arg name="change" id="g9f4lnojapfvv57razup" type="number"></arg></mutation><field name="function_name">changeMood</field><value name="g9f4lnojapfvv57razup"><block type="argument_reporter_number"><field name="VALUE">change</field></block></value><statement name="STACK"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="organism.mood += change;" numlines="1"></mutation></block></statement></block><block type="device_forever" x="10" y="10"><statement name="HANDLER"><block type="device_while"><value name="COND"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="organism.request();" numlines="1"></mutation></block></statement></block></statement></block><block type="control_in_background" x="10" y="10"><statement name="HANDLER"><block type="device_while"><value name="COND"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow></value><statement name="DO"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="organism.mood -= 1;" numlines="1"></mutation></block></statement></block></statement></block><block type="pxt-on-start" x="10" y="10"><statement name="HANDLER"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let print = function (text: string) {" line1="    serial.writeLine(`[OUTPUT] (${input.runningTime()}) text`);" line2="}" numlines="3" declaredvars="print"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let error = function (text: string) {" line1="    serial.writeLine(`[ERROR] (${input.runningTime()}) text`);" line2="}" numlines="3" declaredvars="error"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const enum dataType {" line1="    wantHistory," line2="    fullfilmentTime," line3="    moodGraph" line4="}" numlines="5"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const enum faces {" line1="    happy," line2="    neutral," line3="    sad," line4="    dead" line5="}" numlines="6"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Want {" line1="    index: number;" line2="    sound: SoundExpression;" line3="    name: string;" line4="" line5="    constructor(i: number, s: SoundExpression, n: string) {" line6="        this.index = i;" line7="        this.sound = s;" line8="        this.name = n;" line9="    }" line10="}" numlines="11"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class DataHandler {" line1="    wantHistory: Want[];" line2="" line3="    constructor() {" line4="        this.wantHistory = [];" line5="    }" line6="" line7="    addData(dType: dataType, data: any) {" line8="" line9="    }" line10="" line11="    sendData(dType: dataType, data: any) {" line12="        switch (dType) {" line13="            case dataType.fullfilmentTime:" line14="                // Fulllfilment time, record timestamp + time" line15="                let packet = `ft:${data[0]},${data[1].name},${data[2]}`;" line16="        }" line17="    }" line18="}" numlines="19"></mutation><next><block type="variables_set"><field name="VAR" id="/.=ea?6E,`)T;6i7atDv">wants</field><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="lists_create_with" inline="false"><mutation items="4" horizontalafter="3"></mutation><value name="ADD0"><block type="typescript_expression"><field name="EXPRESSION">new Want(0, soundExpression.spring, "A")</field></block></value><value name="ADD1"><block type="typescript_expression"><field name="EXPRESSION">new Want(1, soundExpression.giggle, "B")</field></block></value><value name="ADD2"><block type="typescript_expression"><field name="EXPRESSION">new Want(2, soundExpression.yawn, "Sleep")</field></block></value><value name="ADD3"><block type="typescript_expression"><field name="EXPRESSION">new Want(3, soundExpression.hello, "Play")</field></block></value></block></value><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let showFace = function(face: faces) {" line1="    switch (face) {" line2="        case faces.happy:" line3="            basic.showLeds(`" line4="                # # . # #" line5="                . . . . ." line6="                # # . # #" line7="                # # . # #" line8="                # # . # #`);" line9="            break;" line10="        case faces.neutral:" line11="            basic.showLeds(`" line12="                # # . # #" line13="                . . . . ." line14="                # # . # #" line15="                # # . # #" line16="                . . . . .`);" line17="            break;" line18="        case faces.sad:" line19="            basic.showLeds(`" line20="                . # . # ." line21="                # . . . #" line22="                # # . # #" line23="                # # . # #" line24="                . . . . .`);" line25="            break;" line26="        case faces.dead:" line27="            basic.showLeds(`" line28="                . # . # ." line29="                # . . . #" line30="                . . . . ." line31="                # # . # #" line32="                . . . . .`);" line33="            break;" line34="    }" line35="}" numlines="36" declaredvars="showFace"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Organism {" line1="    dataHandler: DataHandler;" line2="    mood: number;" line3="" line4="    constructor() {" line5="        this.dataHandler = new DataHandler();" line6="        this.mood = 50;" line7="    }" line8="" line9="    showMood = function (mood: number) {" line10="        if (mood &gt; 0 &amp;&amp; mood &lt; 25) showFace(faces.sad);" line11="        else if (mood &gt;= 25 &amp;&amp; mood &lt; 75) showFace(faces.neutral);" line12="        else if (mood &gt;= 75) showFace(faces.happy);" line13="        else showFace(faces.dead);" line14="    }" line15="" line16="    request() {" line17="        let want = wants[randint(0, wants.length - 1)];" line18="        //input.calibrateCompass();" line19="" line20="        music.play(want.sound, music.PlaybackMode.UntilDone);" line21="        basic.showNumber(want.index); // Remove when verified that sound works" line22="        let start = input.runningTime(); // The time it made the request" line23="" line24="        control.waitForEvent(want.index, want.index);" line25="        let end = input.runningTime(); // The time the request was fulfilled" line26="        " line27="        let diff = end - start; // The fulfilment time in milliseconds" line28="" line29="        this.setData(dataType.wantHistory, want); // Add to want history" line30="        this.setData(dataType.fullfilmentTime, [start, want, diff]); // Add fulfilmentTime" line31="        this.mood += 10;" line32="    }" line33="" line34="    setData(dType: dataType, data: any) {" line35="        this.dataHandler.addData(dType, data);" line36="    }" line37="}" numlines="38"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let organism = new Organism();" numlines="1" declaredvars="organism"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let getMood = function() {" line1="    return organism.mood;" line2="}" numlines="3" declaredvars="getMood"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="device_button_event" x="211" y="5445"><field name="NAME">Button.A</field><statement name="HANDLER"><block type="control_raise_event"><value name="src"><shadow type="control_event_source_id"><field name="id">EventBusSource.MICROBIT_ID_BUTTON_A</field></shadow><block type="math_number"><field name="NUM">0</field></block></value><value name="value"><shadow type="control_event_value_id"><field name="id">EventBusValue.MICROBIT_EVT_ANY</field></shadow><block type="math_number"><field name="NUM">0</field></block></value></block></statement></block><block type="device_button_event" x="473" y="5445"><field name="NAME">Button.B</field><statement name="HANDLER"><block type="control_raise_event"><value name="src"><shadow type="control_event_source_id"><field name="id">EventBusSource.MICROBIT_ID_BUTTON_A</field></shadow><block type="math_number"><field name="NUM">1</field></block></value><value name="value"><shadow type="control_event_value_id"><field name="id">EventBusValue.MICROBIT_EVT_ANY</field></shadow><block type="math_number"><field name="NUM">1</field></block></value></block></statement></block><block type="device_gesture_event" x="278" y="5714"><field name="NAME">Gesture.Shake</field><statement name="HANDLER"><block type="control_raise_event"><value name="src"><shadow type="control_event_source_id"><field name="id">EventBusSource.MICROBIT_ID_BUTTON_A</field></shadow><block type="math_number"><field name="NUM">3</field></block></value><value name="value"><shadow type="control_event_value_id"><field name="id">EventBusValue.MICROBIT_EVT_ANY</field></shadow><block type="math_number"><field name="NUM">3</field></block></value></block></statement></block><block type="input_on_sound" x="508" y="5714"><field name="sound">DetectedSound.Loud</field><statement name="HANDLER"><block type="control_raise_event"><value name="src"><shadow type="contr