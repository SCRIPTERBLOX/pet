ame="ADD0"><block type="typescript_expression" id="Q=U4u-(bZKXMr-,3yhoM"><field name="EXPRESSION">new Want(0, soundExpression.spring)</field></block></value><value name="ADD1"><block type="typescript_expression" id="$nmm!7Rjrp#o(akiT)zl"><field name="EXPRESSION">new Want(1, soundExpression.giggle)</field></block></value><value name="ADD2"><block type="typescript_expression" id="lcR#{NQs~!M0VrOD;1(y"><field name="EXPRESSION">new Want(2, soundExpression.yawn)</field></block></value><value name="ADD3"><block type="typescript_expression" id="@h_ys98KN_JDZ-:hOe4r"><field name="EXPRESSION">new Want(3, soundExpression.hello)</field></block></value></block></value><next><block type="typescript_statement" id="3.j6G90an5HR3H6?rUN."><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let showFace = function (face: faces) {" line1="    switch (face) {" line2="        case faces.happy:" line3="            basic.showLeds(`" line4="                # # . # #" line5="                . . . . ." line6="                # # . # #" line7="                # # . # #" line8="                # # . # #`);" line9="            break;" line10="        case faces.neutral:" line11="            basic.showLeds(`" line12="                # # . # #" line13="                . . . . ." line14="                # # . # #" line15="                # # . # #" line16="                . . . . .`);" line17="            break;" line18="        case faces.sad:" line19="            basic.showLeds(`" line20="                . # . # ." line21="                # . . . #" line22="                # # . # #" line23="                # # . # #" line24="                . . . . .`);" line25="            break;" line26="        case faces.dead:" line27="            basic.showLeds(`" line28="                . # . # ." line29="                # . . . #" line30="                . . . . ." line31="                # # . # #" line32="                . . . . .`);" line33="            break;" line34="    }" line35="}" numlines="36" declaredvars="showFace"></mutation><next><block type="typescript_statement" id="m`pAH/m+zQCV=jbq(Wy~"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Organism {" line1="    wantHistory: Want[];" line2="    mood: number;" line3="" line4="    constructor() {" line5="        this.wantHistory = [];" line6="        this.mood = 50;" line7="    }" line8="" line9="    showMood = function (mood: number) {" line10="        if (mood &gt; 0 &amp;&amp; mood &lt; 25) showFace(faces.sad);" line11="        else if (mood &gt;= 25 &amp;&amp; mood &lt; 75) showFace(faces.neutral);" line12="        else if (mood &gt;= 75) showFace(faces.happy);" line13="        else showFace(faces.dead);" line14="    }" line15="" line16="    request = function () {" line17="        let want = wants[randint(0, wants.length - 1)];" line18="        input.calibrateCompass();" line19="" line20="        music.play(want.sound, music.PlaybackMode.UntilDone);" line21="        basic.showNumber(want.index); // Remove when verified that sound works" line22="        let start = input.runningTime();" line23="" line24="        control.waitForEvent(want.index, want.index);" line25="        let end = input.runningTime();" line26="        " line27="        let diff = end - start;" line28="" line29="        organism.wantHistory.push(want);" line30="        // TODO: Setup with data logging" line31="        print(`${organism.wantHistory[organism.wantHistory.length - 1].index}`);" line32="    }" line33="" line34="    sendData = function (dType: dataType, data: any) {" line35="        switch (dType) {" line36="            case dataType.fullfilmentTime:" line37="                // Fulllfilment time, record timestamp + time" line38="                let packet = `ft:${data[0]},${data[1]},${data[2]}`;" line39="        }" line40="    }" line41="}" numlines="42"></mutation><next><block type="typescript_statement" id=")WZPOb*!};;prqK__MH%"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let organism = new Organi